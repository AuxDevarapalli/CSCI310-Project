@startuml class-c3-model
!pragma layout smetana
!include style.iuml
skinparam classAttributeIconSize 0
hide empty members
title C3 Domain model (revised)

package "model" {
  class User {
    -uid : String
    -name : String
    -uscEmail : String
    -uscId : String
    +NEW(getInitials() / withName(name))
  }
  class Group <<changed>> {
    -id, name, description : String
    -ownerId : String
    -memberIds : List<String>
    -createdAt : long
    +isMember(uid) : boolean
    +NEW(isOwner(uid) : boolean)
    +NEW(withMember(uid) / withoutMember(uid))
    +NEW(withOwner(newOwnerId))
  }
  abstract class Transaction <<changed>> {
    -id : String
    -NEW(groupId : String)
    -creatorId : String
    -date : String
    -createdAt : long
    -note : String
    +{abstract} getType() : TransactionType
    +{abstract} getAmountCents() : long
    +NEW(involves(uid) / isCreatedBy(uid))
  }
  class Expense {
    -title : String
    -totalCents : long
    -category : Category
    -payerId : String
    -splitMethod : SplitMethod
    -shares : List<Share>
    +NEW(getShareFor(uid) : long)
  }
  class Settlement {
    -payerId : String
    -receiverId : String
    -amountCents : long
  }
  class Share {
    -participantId : String
    -amountCents : long
    -percentBasisPoints : int
  }
  enum Category {
    FOOD
    HOUSING
    TRANSPORTATION
    ENTERTAINMENT
    OTHER
  }
  enum SplitMethod {
    EQUAL
    EXACT
    PERCENTAGE
  }
  enum TransactionType {
    EXPENSE
    SETTLEMENT
  }
}

Transaction <|-- Expense
Transaction <|-- Settlement
Expense "1" *-- "2..*" Share
Expense --> Category
Expense --> SplitMethod
Transaction --> TransactionType
Group "1" o-- "*" Transaction : groupId
Group "*" o-- "*" User : memberIds
@enduml
