<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_s">

    <TextView
        android:id="@+id/member_avatar"
        style="@style/SplitSmart.Avatar"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/member_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/member_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/member_owner_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="2dp"
        android:text="@string/badge_owner"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/md_on_secondary_container"
        android:visibility="gone" />

    <!-- Owner only: opens "Make owner" / "Remove from group" for this member. -->
    <ImageView
        android:id="@+id/member_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_member_options"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        android:visibility="gone" />
</LinearLayout>
