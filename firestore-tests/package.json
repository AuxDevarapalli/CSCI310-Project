{
  "name": "splitsmart-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Checks firestore.rules against the Firestore emulator (NFR 4) and prepares demo data.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-splitsmart \"node --test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project splitsmart-team04",
    "seed:emulator": "node seed-demo-data.js --emulator",
    "seed": "node seed-demo-data.js --live"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.2"
  }
}
