@startuml seq-balance
!include style.iuml
title Figure 5 (revised): View the balance page — FR 4.1–4.5
actor User
participant ":BalanceFragment" as UI
participant ":BalanceViewModel" as VM
participant ":GroupRepository" as GR #D9F2DE
participant ":TransactionRepository" as TR
participant ":UserRepository" as UR
participant ":BalanceCalculator" as BC
participant "Money" as M
participant "db :\nFirebaseFirestore" as DB

User -> UI : open Balances tab, CHG(return to it)\nor pull to refresh
UI -> VM : CHG(loadBalances(groupId))
VM -[#2E7D32]> GR : NEW(getGroup(groupId, cb))
GR -> DB : get groups/{groupId}
note right of VM #D9F2DE : NEW: reload the group so members\nadded since the last visit appear
VM -> TR : getTransactions(groupId, cb)
TR -> DB : get groups/{groupId}/transactions
alt load fails
  TR --> VM : cb.onFailure(e)
  VM --> UI : loadError (LiveData)
  UI --> User : error message with Retry
else load succeeds
  TR --> VM : cb.onSuccess(transactions)
  VM -> UR : getUsers(group.memberIds, cb)
  UR -> DB : get users/{uid} for each member
  UR --> VM : cb.onSuccess(members)
  VM -> BC : computeSummary(uid, members, transactions)
  loop each other member m
    BC -> BC : net = netBetween(uid, m.uid, transactions)
    note right of BC : only expenses and settlements between\nthe two users; never merged across pairs (FR 4.4)
  end
  BC -> BC : totalToPay = Σ -net where net < 0\ntotalToReceive = Σ net where net > 0
  BC --> VM : summary
  VM -[#2E7D32]> VM : NEW(sort: open balances first then largest first)
  VM --> UI : summary (LiveData)
  UI -> M : format(cents) for each amount
  M --> UI : "$10.00"
  UI --> User : "Bob owes you $10.00", "You owe David $4.00",\nTotal to pay, Total to receive, NEW(Settle up shortcut)
end
@enduml
