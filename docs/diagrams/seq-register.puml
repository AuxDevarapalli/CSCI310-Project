@startuml seq-register
!include style.iuml
title Figure 3 (revised): Register an account — FR 1.1, 1.2, NFR 4
actor User
participant ":RegisterActivity" as UI
participant ":AuthViewModel" as VM
participant ":InputValidator" as V
participant ":AuthRepository" as R
participant "auth :\nFirebaseAuth" as A
participant "db :\nFirebaseFirestore" as DB

User -> UI : enter name, USC email, USC ID,\npassword, CHG(confirm password); tap Create account
UI -> VM : register(name, email, uscId, password, CHG(confirm))
VM -> V : validateRegistration(name, email, uscId,\npassword, CHG(confirm))
V --> VM : result
alt result is not valid
  VM --> UI : fieldError (LiveData)
  UI --> User : error shown on that field, no account created
else result is valid
  VM -> R : register(name, CHG(normalized email), uscId, password,\nCHG(nowMillis), cb)
  R -[#C76E00]> A : CHG(createUserWithEmailAndPassword(email, password))
  note right of R #FFE7C2 : CHANGED: the account is created first, so the\nUSC ID check below runs as a signed-in user and\nuscIds can stay unreadable to signed-out users (NFR 4)
  alt email already registered
    A --> R : FirebaseAuthUserCollisionException
    R --> VM : cb.onFailure("An account with this USC email already exists.")
    VM --> UI : error (Event)
  else account created (password stored as a hash)
    A --> R : firebaseUser
    R -[#C76E00]> DB : CHG(runTransaction: get uscIds/{uscId};)\nCHG(if absent set uscIds/{uscId} and users/{uid})
    alt USC ID already reserved, or the write failed
      DB --> R : transaction aborted
      R -[#2E7D32]> A : NEW(firebaseUser.delete(); signOut())
      note right of R #D9F2DE : NEW: roll back the half-created\nlogin so the email can be reused
      R --> VM : cb.onFailure("An account with this USC ID already exists.")
      VM --> UI : error (Event)
    else both documents written atomically (FR 1.2)
      DB --> R : success
      R --> VM : cb.onSuccess(user)
      VM --> UI : currentUser = user (LiveData)
      UI --> User : open GroupListActivity
    end
  end
end
@enduml
