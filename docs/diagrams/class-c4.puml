@startuml class-c4
!pragma layout smetana
!include style.iuml
skinparam classAttributeIconSize 0
hide empty members
title C4 Repositories (data access) and C5/C6 Firebase — revised class diagram

package "data" {
  class AuthRepository <<changed>> {
    -auth : FirebaseAuth
    -db : FirebaseFirestore
    +{static} NEW(create() / isFirebaseConfigured(context))
    +NEW(getCurrentUserId() / isLoggedIn())
    +CHG(register(name, email, uscId, password, nowMillis, cb))
    +login(email, password, cb)
    +NEW(getCurrentUser(cb) / logout())
  }
  class UserRepository <<changed>> {
    -db : FirebaseFirestore
    +getUser(uid, cb)
    +NEW(getUsers(uids, cb))
    +NEW(findByEmail(email, cb))
    +CHG(updateName(user, newName, cb))
  }
  class GroupRepository <<changed>> {
    -db : FirebaseFirestore
    +CHG(createGroup(name, description, ownerId, nowMillis, cb))
    +NEW(getGroup(groupId, cb) / getGroupsForUser(uid, cb))
    +NEW(updateGroup(groupId, name, description, cb))
    +CHG(addMember(groupId, uid, cb))
    +NEW(deleteGroup(groupId, cb))
    +NEW(removeMember(groupId, uid, cb))
    +NEW(transferOwnership(groupId, newOwnerId, cb))
    +NEW(observeGroup(groupId, onChange) : Subscription)
    +NEW(observeGroupsForUser(uid, onChange) : Subscription)
  }
  class TransactionRepository <<changed>> {
    -db : FirebaseFirestore
    +getTransactions(groupId, cb)
    +NEW(getTransaction(groupId, id, cb))
    +CHG(addExpense(expense, nowMillis, cb))
    +NEW(updateExpense(expense, nowMillis, cb))
    +CHG(addSettlement(settlement, nowMillis, cb))
    +NEW(updateSettlement(settlement, nowMillis, cb))
    +NEW(deleteTransaction(groupId, id, cb))
    +NEW(observeTransactions(groupId, onChange) : Subscription)
  }
  class Subscription <<new>> {
    -registration : ListenerRegistration
    +remove()
    ~{static} changesOnly(metadata, onChange)
  }
  class FirebaseEmulators <<new>> {
    +{static} connect(host)
  }
  interface "DataCallback<T>" as DataCallback <<changed>> {
    +onSuccess(value : T) : void
    +CHG(onFailure(e : Exception) : void)
  }
  class FirestoreMapper <<new>> {
    +{static} userToMap() / toUser()
    +{static} groupToMap() / toGroup()
    +{static} expenseToMap() / settlementToMap()
    +{static} toTransaction(doc, groupId)
  }
  class FirebaseErrors <<new>> {
    +{static} wrap(e : Exception) : RepositoryException
  }
  class RepositoryException <<new>> {
    -notFound : boolean
    +isNotFound() : boolean
  }
}

package "C5 / C6 Firebase SDK (external)" {
  class FirebaseAuth <<external>>
  class FirebaseFirestore <<external>>
  class DocumentSnapshot <<external>>
}

AuthRepository -[hidden]down- DataCallback
UserRepository -[hidden]down- FirestoreMapper
GroupRepository -[hidden]down- FirebaseErrors
FirebaseErrors ..> RepositoryException : creates
RepositoryException -[hidden]down- FirebaseAuth
FirestoreMapper ..> DocumentSnapshot
AuthRepository --> FirebaseAuth
TransactionRepository --> FirebaseFirestore
TransactionRepository ..> Subscription : creates
GroupRepository ..> Subscription : creates
GroupRepository --> FirebaseFirestore
@enduml
