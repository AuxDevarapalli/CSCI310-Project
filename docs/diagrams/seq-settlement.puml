@startuml seq-settlement
!include style.iuml
title Figure 6 (revised): Record a settlement — FR 5.1–5.3
actor User
participant ":SettlementFormActivity" as UI
participant ":SettlementViewModel" as VM
participant ":GroupRepository" as GR
participant ":UserRepository" as UR
participant ":TransactionRepository" as TR
participant ":BalanceCalculator" as BC
participant "Money" as M
participant ":InputValidator" as V
participant ":DateProvider" as D
participant "db :\nFirebaseFirestore" as DB

User -> UI : tap Settle up, NEW(or Settle up next to a balance)
UI -> VM : CHG(init(groupId, null, receiverId))
VM -[#C76E00]> GR : CHG(getGroup(groupId, cb))
VM -[#C76E00]> UR : CHG(getUsers(group.memberIds, cb))
VM -[#C76E00]> TR : CHG(getTransactions(groupId, cb))
note right of VM #FFE7C2 : CHANGED: everything is loaded once in init()\ninstead of on every selectReceiver()
TR -> DB : get groups/{groupId}/transactions
TR --> VM : transactions
User -> UI : choose the member paid
UI -> VM : selectReceiver(uid)
VM -> BC : CHG(amountOwed(currentUid, uid, transactions))
note right of BC : amountOwed = max(0, -netBetween(currentUid, uid, transactions))\nCHG(the settlement being edited is left out of the sum)
BC --> VM : owedCents
alt owedCents == 0
  VM --> UI : owedCents = 0 (LiveData)
  UI --> User : "You don't owe Bob anything", Save disabled
else owedCents > 0
  VM --> UI : owedCents (LiveData)
  UI --> User : "You owe Bob $11.00", NEW(Pay-the-full-amount chip)
end
User -> UI : enter amount and note, tap Save
UI -> VM : save(amountText, note)
VM -> M : parseDollars(amountText)
M --> VM : amountCents
VM -[#2E7D32]> TR : NEW(getTransactions(groupId, cb))
note right of VM #D9F2DE : NEW: re-read right before saving so the\nlimit uses the current balance (FR 5.2)
TR --> VM : fresh transactions
VM -[#2E7D32]> BC : NEW(amountOwed(currentUid, receiverId, transactions))
VM -> V : validateSettlement(amountCents, owedCents)
V --> VM : result
alt not valid (not above $0.00, or more than owed)
  VM --> UI : fieldError (LiveData)
else valid
  VM -> D : today(), nowMillis()
  VM -> TR : addSettlement(settlement, CHG(nowMillis), cb)
  TR -> DB : add groups/{groupId}/transactions (type = SETTLEMENT)
  TR --> VM : cb.onSuccess(id)
  VM --> UI : saved (Event)
  UI --> User : form closes; the balance with Bob is lower on reload
end
@enduml
