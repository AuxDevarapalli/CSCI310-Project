    <!-- Setup -->
    <string name="setup_title">Firebase setup needed</string>
    <string name="setup_message">This build of SplitSmart does not include a Firebase configuration, so it cannot reach the shared database yet.\n\n1. Create a Firebase project and add an Android app with the package name com.team04.splitsmart.\n2. Download google-services.json and place it in the app/ folder of the project.\n3. Enable Email/Password sign-in and create a Cloud Firestore database.\n4. Rebuild and run the app.\n\nThe README in the repository walks through every step.</string>

